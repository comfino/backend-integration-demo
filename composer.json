{
    "name": "comfino/backend-integration-demo",
    "type": "project",
    "description": "Runnable backend integration guide for the ComfinoPay payment gateway (custom shops and multi-tenant SaaS platforms).",
    "homepage": "https://github.com/comfino/backend-integration-demo",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "ext-zlib": "*",
        "comfino/php-api-client": "^4.1",
        "comfino/php-sdk": "^3.5",
        "sunrise/http-client-curl": "^2.2",
        "sunrise/http-message": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
