# ─────────────────────────────────────────────────────────────────────────────
# Comfino backend integration demo — configuration template.
#
# Copy to `.env` (`cp .env.dist .env`) and fill in your own sandbox credentials.
# `.env` is git-ignored — NEVER commit real API/widget keys to a public repo.
# Sandbox keys are issued in the Comfino sandbox panel (https://panel.craty.pl).
# ─────────────────────────────────────────────────────────────────────────────

# Environment: true = sandbox (craty.pl), false = production (comfino.pl)
SANDBOX_MODE=true

# API language (ISO 639-1): pl | en
LANGUAGE=pl

# ── Shared credentials ───────────────────────────────────────────────────────
# Used as the default for every demo tenant that has no tenant-specific key set
# (see below). Pages render without them, but live API calls will fail auth.
SANDBOX_API_KEY=
SANDBOX_WIDGET_KEY=

# Production credentials (used when SANDBOX_MODE=false).
API_KEY=
WIDGET_KEY=

# ── Per-tenant overrides (multi-tenant / SaaS pattern) ───────────────────────
# A real SaaS platform stores one key set per shop. These optional overrides let
# each demo tenant use its own credentials; leave empty to share the keys above.
SHOP_A_API_KEY=
SHOP_A_WIDGET_KEY=
SHOP_B_API_KEY=
SHOP_B_WIDGET_KEY=

# ── Demo customer (order-create recipe) ──────────────────────────────────────
TEST_EMAIL=
TEST_PHONE_NUMBER=

# ── Comfino REST API host ────────────────────────────────────────────────────
# Custom overrides the SANDBOX_MODE selection when set (local mocking / staging).
COMFINO_API_HOST_PRODUCTION=https://api-ecommerce.comfino.pl
COMFINO_API_HOST_SANDBOX=https://api-ecommerce.craty.pl
COMFINO_API_HOST_CUSTOM=

# ── Platform / plugin identity (sent to the webhook manager & API user agent) ─
PLATFORM_NAME=CustomBackendDemo
PLATFORM_VERSION=1.0.0
PLUGIN_VERSION=1.0.0
